# Dependencies
node_modules/
# package-lock.json is COMMITTED on purpose: `npm ci` - which every
# verification workflow uses - refuses to run without it, and an
# unreproducible dependency tree is not something you can verify.

# Build output (electron-builder outputs to dist/ by default, covers NSIS installer, portable .exe, mac .dmg, linux AppImage)
dist/
dist-final/
out/

